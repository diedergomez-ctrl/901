local function getClosestTarget()
    local closestPlayer = nil
    local shortestDistance = Settings.FOVRadius

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            local part = player.Character:FindFirstChild(Settings.TargetPart) or player.Character:FindFirstChild("HumanoidRootPart")
            
            if humanoid and humanoid.Health > 0 and part then
                local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    local mousePos = Vector2.new(Mouse.X, Mouse.Y)
                    local distance = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude

                    if distance < shortestDistance then
                        closestPlayer = player
                        shortestDistance = distance
                    end
                end
            end
        end
    end
    return closestPlayer
end

-- Hooking Mouse Index for Magic Bullets (Silent Aim True Logic)
local gmt = getrawmetatable(game)
local oldIndex = gmt.__index
setreadonly(gmt, false)

gmt.__index = newcclosure(function(self, idx)
    if not checkcaller() and Settings.SilentAim then
        if idx == "Hit" or idx == "Target" then
            local target = getClosestTarget()
            if target and target.Character and target.Character:FindFirstChild(Settings.TargetPart) then
                local targetPart = target.Character[Settings.TargetPart]
                if idx == "Hit" then
                    return targetPart.CFrame
                elseif idx == "Target" then
                    return targetPart
                end
            end
        end
    end
    return oldIndex(self, idx)
end)

setreadonly(gmt, true)

-- 🎨 [WEAPON & COVER CHECK FOR ESP]
local function getWeaponColor(character)
    local tool = character:FindFirstChildOfClass("Tool")
    if not tool then return Color3.fromRGB(240, 240, 240), "بدون سلاح" end
    local name = tool.Name
    local lower = string.lower(name)
    if string.find(lower, "ak") or string.find(lower, "m4") or string.find(lower, "shotgun") or string.find(lower, "rifle") then
        return Color3.fromRGB(255, 85, 0), name
    elseif string.find(lower, "pistol") or string.find(lower, "glock") or string.find(lower, "smg") then
        return Color3.fromRGB(255, 215, 0), name
    else
        return Color3.fromRGB(180, 255, 255), name
    end
end

local function isPlayerInCover(targetChar)
    if not targetChar or not targetChar:FindFirstChild("Head") or not LocalPlayer.Character then return true end
    local origin = Camera.CFrame.Position
    local targetPos = targetChar.Head.Position
    local rayParams = RaycastParams.new()
    rayParams.FilterType = RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = {LocalPlayer.Character, targetChar}
    return workspace:Raycast(origin, targetPos - origin, rayParams) ~= nil
end

-- ESP Drawings Storage
local ESP_Cache = {}
local function createESP(player)
    local drawings = {Text = Drawing.new("Text"), Box = Drawing.new("Square")}
    drawings.Text.Size = 13
    drawings.Text.Center = true
    drawings.Text.Outline = true
    drawings.Text.Visible = false
    drawings.Box.Thickness = 1.5
    drawings.Box.Filled = false
    drawings.Box.Visible = false
    ESP_Cache[player] = drawings
end

Players.PlayerRemoving:Connect(function(p)
    if ESP_Cache[p] then
        ESP_Cache[p].Text:Remove()
        ESP_Cache[p].Box:Remove()
        ESP_Cache[p] = nil
    end
end)

-- 🚀 [RENDER LOOP]
RunService.RenderStepped:Connect(function()
    FOVCircle.Position = Vector2.new(Mouse.X, Mouse.Y)
    FOVCircle.Radius = Settings.FOVRadius
    FOVCircle.Visible = Settings.ShowFOV

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if not ESP_Cache[player] then createESP(player) end
            local drawings = ESP_Cache[player]
            local char = player.Character

            if Settings.EspEnabled and char and char:FindFirstChild("HumanoidRootPart") then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local hrpPos, onScreen = Camera:WorldToViewportPoint(char.HumanoidRootPart.Position)
                    if onScreen then
                        local nameColor, weaponName = getWeaponColor(char)
                        local inCover = isPlayerInCover(char)
                        local statusColor = inCover and Color3.fromRGB(255, 40, 40) or Color3.fromRGB(40, 255, 100)
                        local statusText = inCover and "[Cover 🟥]" or "[Open 🟩]"

                        drawings.Text.Text = string.format("%s | %d HP\n🔫 %s | %s", player.DisplayName, math.floor(hum.Health), weaponName, statusText)
                        drawings.Text.Position = Vector2.new(hrpPos.X, hrpPos.Y - 45)
                        drawings.Text.Color = nameColor
                        drawings.Text.Visible = true

                        drawings.Box.Size = Vector2.new(2000 / hrpPos.Z, 3000 / hrpPos.Z)
                        drawings.Box.Position = Vector2.new(hrpPos.X - drawings.Box.Size.X / 2, hrpPos.Y - drawings.Box.Size.Y / 2)
                        drawings.Box.Color = statusColor
                        drawings.Box.Visible = true
                    else
                        drawings.Text.Visible = false
                        drawings.Box.Visible = false
                    end
                else
                    drawings.Text.Visible = false
                    drawings.Box.Visible = false
                end
            else
                drawings.Text.Visible = false
                drawings.Box.Visible = false
            end
        end
    end
end)

