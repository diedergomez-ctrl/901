    IconLbl.Text = icon
    IconLbl.TextSize = 12
    IconLbl.BackgroundTransparency = 1
    IconLbl.Parent = Btn

    local TextLbl = Instance.new("TextLabel")
    TextLbl.Size = UDim2.new(1, -45, 1, 0)
    TextLbl.Position = UDim2.new(0, 40, 0, 0)
    TextLbl.Text = name
    TextLbl.TextColor3 = Color3.fromRGB(180, 180, 195)
    TextLbl.Font = Enum.Font.GothamMedium
    TextLbl.TextSize = 11
    TextLbl.TextXAlignment = Enum.TextXAlignment.Left
    TextLbl.BackgroundTransparency = 1
    TextLbl.Parent = Btn

    Btn.MouseButton1Click:Connect(function()
        for _, b in pairs(TabButtons) do
            b.Frame.BackgroundColor3 = Color3.fromRGB(25, 25, 32)
            b.Text.TextColor3 = Color3.fromRGB(180, 180, 195)
        end
        Btn.BackgroundColor3 = Color3.fromRGB(40, 40, 52)
        TextLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    end)

    table.insert(TabButtons, {Frame = Btn, Text = TextLbl})
    return Btn
end

