-- ⚙️ نظام الـ ESP البرمجي
---------------------------------------------------
local ESP_Enabled = false
local Storage = {}

local function ClearStorage(player)
	if Storage[player] then
		if Storage[player].Billboard then
			Storage[player].Billboard:Destroy()
		end
		if Storage[player].Connections then
			for _, conn in ipairs(Storage[player].Connections) do
				if conn then conn:Disconnect() end
			end
		end
		Storage[player] = nil
	end
end

local function MonitorInventory(player)
	ClearStorage(player)
	if player == LocalPlayer then return end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "InvTextESP"
	billboard.AlwaysOnTop = true
	billboard.Size = UDim2.new(0, 300, 0, 25)
	billboard.Active = false
	billboard.StudsOffset = Vector3.new(0, 3, 0)
	billboard.Enabled = false
	
	local container = Instance.new("Frame", billboard)
	container.Size = UDim2.new(1, 0, 1, 0)
	container.BackgroundTransparency = 1
	
	local layout = Instance.new("UIListLayout", container)
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Padding = UDim.new(0, 4)

	Storage[player] = {
		Billboard = billboard,
		Container = container,
		Connections = {}
	}

	local function UpdateItems()
		if not Storage[player] or not Storage[player].Container then return end
		
		for _, child in ipairs(Storage[player].Container:GetChildren()) do
			if child:IsA("TextLabel") then
				child:Destroy()
			end
		end

		if not ESP_Enabled then
			billboard.Enabled = false
			return
		end

		local Character = player.Character
		local Backpack = player:FindFirstChild("Backpack")
		local TotalItems = {}

		if Character then
			for _, tool in ipairs(Character:GetChildren()) do
				if tool:IsA("Tool") then
					table.insert(TotalItems, tool.Name)
				end
			end
		end

		if Backpack then
			for _, tool in ipairs(Backpack:GetChildren()) do
				if tool:IsA("Tool") then
					table.insert(TotalItems, tool.Name)
				end
			end
		end

		if #TotalItems == 0 then
			billboard.Enabled = false
			return
		else
			billboard.Enabled = true
		end

		for _, itemName in ipairs(TotalItems) do
			local textLabel = Instance.new("TextLabel", Storage[player].Container)
			textLabel.Size = UDim2.new(0, 0, 1, 0)
			textLabel.AutomaticSize = Enum.AutomaticSize.X
			textLabel.BackgroundTransparency = 1
			textLabel.Text = "[" .. itemName .. "]"
			textLabel.TextColor3 = Color3.fromRGB(0, 255, 120)
			textLabel.Font = Enum.Font.GothamBold
			textLabel.TextSize = 11
			textLabel.TextStrokeTransparency = 0.2
			textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
		end
	end

	local function SetupCharacter(character)
		if not Storage[player] then return end
		
		local root = character:WaitForChild("HumanoidRootPart", 10)
		if root then
			billboard.Adornee = root
			billboard.Parent = ScreenGui
		end
		
		UpdateItems()
		
		local cAdd = character.ChildAdded:Connect(UpdateItems)
		local cRem = character.ChildRemoved:Connect(UpdateItems)
		table.insert(Storage[player].Connections, cAdd)
		table.insert(Storage[player].Connections, cRem)
	end

	if player.Character then SetupCharacter(player.Character) end
	local charAddedConn = player.CharacterAdded:Connect(SetupCharacter)
	table.insert(Storage[player].Connections, charAddedConn)

	local function SetupBackpackListeners()
		local Backpack = player:WaitForChild("Backpack", 10)
		if Backpack and Storage[player] then
			local bConn = Backpack.ChildAdded:Connect(UpdateItems)
			local bRem = Backpack.ChildRemoved:Connect(UpdateItems)
			table.insert(Storage[player].Connections, bConn)
			table.insert(Storage[player].Connections, bRem)
		end
	end

	SetupBackpackListeners()
	
	local bpConn = player.ChildAdded:Connect(function(child)
		if child.Name == "Backpack" then
			SetupBackpackListeners()
			UpdateItems()
		end
	end)
	table.insert(Storage[player].Connections, bpConn)
end

-- 5. تشغيل التثبيت للكل
for _, player in ipairs(Players:GetPlayers()) do
	MonitorInventory(player)
end
Players.PlayerAdded:Connect(MonitorInventory)
Players.PlayerRemoving:Connect(ClearStorage)

-- 6. برمجة زر التفعيل والإيقاف
ToggleBtn.MouseButton1Click:Connect(function()
	ESP_Enabled = not ESP_Enabled
	
	if ESP_Enabled then
		ToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100) -- أخضر (مفعل)
		ToggleBtn.Text = "Inventory ESP: ON"
	else
		ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50) -- أحمر (معطل)
		ToggleBtn.Text = "Inventory ESP: OFF"
	end
	
	-- تحديث حالة الظهور فوراً لجميع اللاعبين
	for plr, data in pairs(Storage) do
		if data.Billboard then
			if not ESP_Enabled then
				data.Billboard.Enabled = false
			else
				-- إعادة الاحتساب
				if plr.Character then
					local toolCount = #plr.Character:GetChildren() + (plr:FindFirstChild("Backpack") and #plr:FindFirstChild("Backpack"):GetChildren() or 0)
					data.Billboard.Enabled = (toolCount > 0)
				end
			end
		end
	end
end)
