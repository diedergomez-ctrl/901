local function getWeaponInfo(player)
    local labels = {}
    local backpack = player:FindFirstChildOfClass("Backpack")
    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if weaponColors[tool.Name] then table.insert(labels, tool.Name) end
        end
    end
    if player.Character then
        for _, tool in ipairs(player.Character:GetChildren()) do
            if tool:IsA("Tool") and weaponColors[tool.Name] then table.insert(labels, tool.Name) end
        end
    end
    if #labels > 0 then
        return table.concat(labels, ", "), Color3.fromRGB(0, 255, 255)
    end
    return "", nil
end

-- Fast Fire Loops
task.spawn(function()
    while true do
        if configEnabled then
            pcall(function()
                for _, container in ipairs({ localPlayer.Backpack, localPlayer.Character }) do
                    if container then
                        for _, tool in ipairs(container:GetChildren()) do
                            if tool:IsA("Tool") then
                                local configuration = tool:FindFirstChild("Configuration")
                                if configuration then
                                    for _, value in ipairs(configuration:GetChildren()) do
                                        if value:IsA("NumberValue") or value:IsA("IntValue") then
                                            local name = value.Name:lower()
                                            if name:find("hitdamage") or name:find("damage") or name:find("dmg") or name:find("ammo") or name:find("capacity") then
                                                value.Value = 99999
                                            elseif name:find("fire") or name:find("rate") or name:find("delay") or name:find("cooldown") then
                                                value.Value = 0.001
                                            elseif name:find("spread") or name:find("recoil") or name:find("kick") then
                                                value.Value = 0
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        end
        task.wait(0.2)
    end
end)

-- Render Steering
RunService.RenderStepped:Connect(function()
    fovCircle.Position = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer then
            local character = player.Character
            local rootPart = character and character:FindFirstChild("HumanoidRootPart")
            if character and rootPart then
                local screenPos, onScreen = camera:WorldToViewportPoint(rootPart.Position)
                if onScreen then
                    if fovEnabled then
                        if not tracers[player] then
                            local line = Drawing.new("Line")
                            line.Thickness = 1.5
                            tracers[player] = line
                        end
                        local tracer = tracers[player]
                        tracer.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
                        tracer.To = Vector2.new(screenPos.X, screenPos.Y)
                        tracer.Color = Color3.fromRGB(255, 0, 0)
                        tracer.Visible = true
                    else
                        if tracers[player] then tracers[player].Visible = false end
                        if espEnabled then
                            if not boxes[player] then
                                local square = Drawing.new("Square")
                                square.Visible = false
                                square.Thickness = 1
                                square.Color = Color3.fromRGB(255, 255, 255)
                                square.Filled = false
                                boxes[player] = square
                            end
                            local box = boxes[player]
                            local topPos = camera:WorldToViewportPoint(rootPart.Position + Vector3.new(0, 0.5, 0))
                            local height = math.abs(topPos.Y - camera:WorldToViewportPoint(rootPart.Position - Vector3.new(0, 3, 0)).Y)
                            local width = height / 2
                            box.Size = Vector2.new(width, height)
                            box.Position = Vector2.new(topPos.X - width / 2, topPos.Y)
                            box.Visible = true
                            
                            local weaponText, weaponColor = getWeaponInfo(player)
                            if weaponText ~= "" then
                                if not texts[player] then
                                    local text = Drawing.new("Text")
                                    text.Visible = false
                                    text.Size = 12
                                    text.Center = true
                                    text.Outline = true
                                    texts[player] = text
                                end
                                local text = texts[player]
                                text.Text = player.Name .. " [" .. weaponText .. "]"
                                text.Color = weaponColor
                                text.Position = Vector2.new(topPos.X, topPos.Y - 35)
                                text.Visible = true
                            else
                                if texts[player] then texts[player].Visible = false end
                                if not names[player] then
                                    names[player] = {
                                        Drawing.new("Line"), Drawing.new("Line"),
                                        Drawing.new("Line"), Drawing.new("Line"),
                                        Drawing.new("Line"), Drawing.new("Line")
                                    }
                                    for _, line in ipairs(names[player]) do
                                        line.Visible = false
                                        line.Thickness = 1
                                        line.Color = Color3.fromRGB(0, 255, 0)
                                    end
                                end
                                local lines = names[player]
                                local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
                                if character and torso then
                                    local headPos = camera:WorldToViewportPoint(rootPart.Position)
                                    local torsoPos = camera:WorldToViewportPoint(torso.Position)
                                    local footPos = camera:WorldToViewportPoint(rootPart.Position)
                                    lines[1].From = Vector2.new(headPos.X, headPos.Y)
                                    lines[1].To = Vector2.new(torsoPos.X, torsoPos.Y)
                                    lines[1].Visible = true
                                    
                                    if character:FindFirstChild("LeftHand") or character:FindFirstChild("LeftLowerArm") or character:FindFirstChild("Left Arm") then
                                        local limbPos = camera:WorldToViewportPoint((character:FindFirstChild("LeftHand") or character:FindFirstChild("LeftLowerArm") or character:FindFirstChild("Left Arm")).Position)
                                        lines[2].From = Vector2.new(torsoPos.X - height / 2 * 0.25, torsoPos.Y)
                                        lines[2].To = Vector2.new(limbPos.X, limbPos.Y)
                                        lines[2].Visible = true
                                    else names[player][2].Visible = false end
                                    
                                    if character:FindFirstChild("RightHand") or character:FindFirstChild("RightLowerArm") or character:FindFirstChild("Right Arm") then
                                        local limbPos = camera:WorldToViewportPoint((character:FindFirstChild("RightHand") or character:FindFirstChild("RightLowerArm") or character:FindFirstChild("Right Arm")).Position)
                                        lines[3].From = Vector2.new(torsoPos.X + height / 2 * 0.25, torsoPos.Y)
                                        lines[3].To = Vector2.new(limbPos.X, limbPos.Y)
                                        lines[3].Visible = true
                                    else names[player][3].Visible = false end
                                    
                                    lines[4].From = Vector2.new(torsoPos.X, torsoPos.Y)
                                    lines[4].To = Vector2.new(footPos.X, footPos.Y)
                                    lines[4].Visible = true
                                    
                                    if character:FindFirstChild("LeftFoot") or character:FindFirstChild("LeftLowerLeg") or character:FindFirstChild("Left Leg") then
                                        local limbPos = camera:WorldToViewportPoint((character:FindFirstChild("LeftFoot") or character:FindFirstChild("LeftLowerLeg") or character:FindFirstChild("Left Leg")).Position)
                                        lines[5].From = Vector2.new(footPos.X, footPos.Y)
                                        lines[5].To = Vector2.new(limbPos.X, limbPos.Y)
                                        lines[5].Visible = true
                                    else names[player][5].Visible = false end
                                    
                                    if character:FindFirstChild("RightFoot") or character:FindFirstChild("RightLowerLeg") or character:FindFirstChild("Right Leg") then
                                        local limbPos = camera:WorldToViewportPoint((character:FindFirstChild("RightFoot") or character:FindFirstChild("RightLowerLeg") or character:FindFirstChild("Right Leg")).Position)
                                        lines[6].From = Vector2.new(footPos.X, footPos.Y)
                                        lines[6].To = Vector2.new(limbPos.X, limbPos.Y)
                                        lines[6].Visible = true
                                    else names[player][6].Visible = false end
                                end
                            end
                        else
                            if boxes[player] then boxes[player].Visible = false end
                            if texts[player] then texts[player].Visible = false end
                            if names[player] then
                                for _, line in ipairs(names[player]) do line.Visible = false end
                            end
                        end
                    end
                else hidePlayer(player) end
            else hidePlayer(player) end
        end
    end
end)

-- Auto Equip
task.spawn(function()
    while true do
        if autoHitEnabled then
            pcall(function()
                local character = localPlayer.Character
                local humanoid = character and character:FindFirstChild("Humanoid")
                local backpack = localPlayer:FindFirstChildOfClass("Backpack")
                if character and backpack then
                    local equipped = character:FindFirstChild("AK47")
                    if not equipped then
                        local tool = backpack:FindFirstChild("AK47")
                        if tool then humanoid:EquipTool(tool) end
                    end
                end
            end)
        end
        task.wait(0.5)
    end
end)

