-- Helper Function for Buttons
local function createButton(text, posY)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 38)
    btn.Position = UDim2.new(0.05, 0, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    btn.Text = text
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 14
    btn.Parent = Frame
    return btn
end

-- Create Menu Buttons
local Btn_FOV = createButton("FOV & Tracers: OFF", 42)
local Btn_ESP = createButton("ESP (Box + Skeleton): OFF", 86)
local Btn_AutoHit = createButton("Auto Hit Fire: OFF", 130)
local Btn_Stamina = createButton("Infinite Stamina: OFF", 174)
local Btn_FastFire = createButton("Fast Fire Config: OFF", 218)

-- FOV Circle
local Circle = Drawing.new("Circle")
Circle.Visible = false
Circle.Radius = 120
Circle.Color = Color3.fromRGB(255, 255, 255)
Circle.Thickness = 1
Circle.Transparency = 0.7

-- Button Triggers
Btn_FOV.MouseButton1Click:Connect(function()
    Btn_FOV.Text = "FOV & Tracers: ON"
    Btn_FOV.TextColor3 = Color3.fromRGB(0, 255, 0)
    Circle.Visible = true
end)

-- Infinite Stamina Remote Exploit (الريموت المكشوف)
Btn_Stamina.MouseButton1Click:Connect(function()
    Btn_Stamina.Text = "Infinite Stamina: ON"
