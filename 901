local function hidePlayer(player)
    if boxes[player] then boxes[player].Visible = false end
    if texts[player] then texts[player].Visible = false end
    if tracers[player] then tracers[player].Visible = false end
    if names[player] then
        for _, line in ipairs(names[player]) do line.Visible = false end
    end
end

local function removePlayer(player)
    if boxes[player] then boxes[player]:Remove(); boxes[player] = nil end
    if texts[player] then texts[player]:Remove(); texts[player] = nil end
    if tracers[player] then tracers[player]:Remove(); tracers[player] = nil end
    if names[player] then
        for _, line in ipairs(names[player]) do line:Remove() end
        names[player] = nil
    end
end

local function clearAll()
    for _, player in ipairs(Players:GetPlayers()) do
        removePlayer(player)
    end
end

