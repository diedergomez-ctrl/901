-- 🎨 [DRAWINGS ENGINE - FOV & ESP]
local FOVCircle = Drawing.new("Circle")
FOVCircle.Color = Color3.fromRGB(0, 200, 255)
FOVCircle.Thickness = 1.5
FOVCircle.NumSides = 80
FOVCircle.Filled = false
FOVCircle.Transparency = 0.7
FOVCircle.Visible = false

local ESP_Cache = {}
local function createESP(player)
    local drawings = {Text = Drawing.new("Text"), Box = Drawing.new("Square")}
    drawings.Text.Size = 13
    drawings.Text.Center = true
    drawings.Text.Outline = true
    drawings.Text.Visible = false
    drawings.Box.Thickness = 1.5
    drawings.Box.Filled = false
    drawings.Box.Visible = false
    ESP_Cache[player] = drawings
end

Players.PlayerRemoving:Connect(function(p)
    if ESP_Cache[p] then
        ESP_Cache[p].Text:Remove()
        ESP_Cache[p].Box:Remove()
        ESP_Cache[p] = nil
    end
end)

local function isPlayerInCover(targetChar)
    if not targetChar or not targetChar:FindFirstChild("Head") or not LocalPlayer.Character then return true end
    local origin = Camera.CFrame.Position
    local targetPos = targetChar.Head.Position
    local rayParams = RaycastParams.new()
    rayParams.FilterType = RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = {LocalPlayer.Character, targetChar}
    return workspace:Raycast(origin, targetPos - origin, rayParams) ~= nil
end

-- 🚀 [ACTIVE RENDER & AIM ENGINE]
RunService.RenderStepped:Connect(function()
    -- Update FOV Circle
    local mousePos = UserInputService:GetMouseLocation()
    FOVCircle.Position = mousePos
    FOVCircle.Radius = Settings.FOVRadius
    FOVCircle.Visible = Settings.ShowFOV

    -- Safe Silent Aim Logic (Rotates Weapon Handle Safe)
    if Settings.SilentAim then
        local target = getClosestTarget()
        if target and target.Character and target.Character:FindFirstChild(Settings.TargetPart) then
            local character = LocalPlayer.Character
            if character then
                local tool = character:FindFirstChildOfClass("Tool")
                if tool and tool:FindFirstChild("Handle") then
                    tool.Handle.CFrame = CFrame.new(tool.Handle.Position, target.Character[Settings.TargetPart].Position)
                end
            end
        end
    end

    -- Update ESP Radar
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if not ESP_Cache[player] then createESP(player) end
            local drawings = ESP_Cache[player]
            local char = player.Character

            if Settings.EspEnabled and char and char:FindFirstChild("HumanoidRootPart") then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local hrpPos, onScreen = Camera:WorldToViewportPoint(char.HumanoidRootPart.Position)
                    if onScreen then
                        local inCover = isPlayerInCover(char)
                        local statusColor = inCover and Color3.fromRGB(255, 40, 40) or Color3.fromRGB(40, 255, 100)
                        local statusText = inCover and "[Cover 🟥]" or "[Open 🟩]"

                        drawings.Text.Text = string.format("%s | %d HP\n%s", player.DisplayName, math.floor(hum.Health), statusText)
                        drawings.Text.Position = Vector2.new(hrpPos.X, hrpPos.Y - 40)
                        drawings.Text.Color = statusColor
                        drawings.Text.Visible = true

                        drawings.Box.Size = Vector2.new(2000 / hrpPos.Z, 3000 / hrpPos.Z)
                        drawings.Box.Position = Vector2.new(hrpPos.X - drawings.Box.Size.X / 2, hrpPos.Y - drawings.Box.Size.Y / 2)
                        drawings.Box.Color = statusColor
                        drawings.Box.Visible = true
                    else
                        drawings.Text.Visible = false
                        drawings.Box.Visible = false
                    end
                else
                    drawings.Text.Visible = false
                    drawings.Box.Visible = false
                end
            else
                drawings.Text.Visible = false
                drawings.Box.Visible = false
            end
        end
    end
end)

