local function createToggle(text, default, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 42)
    frame.BackgroundColor3 = Color3.fromRGB(25, 25, 33)
    frame.Parent = Container
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0.7, 0, 1, 0)
    lbl.Position = UDim2.new(0, 12, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = Color3.fromRGB(230, 230, 230)
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = frame

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 50, 0, 24)
    btn.Position = UDim2.new(1, -60, 0.5, -12)
    btn.BackgroundColor3 = default and Color3.fromRGB(138, 43, 226) or Color3.fromRGB(45, 45, 55)
    btn.Text = default and "ON" or "OFF"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    btn.Parent = frame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 12)

    local state = default
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.BackgroundColor3 = state and Color3.fromRGB(138, 43, 226) or Color3.fromRGB(45, 45, 55)
        btn.Text = state and "ON" or "OFF"
        callback(state)
    end)
end

local ItemESP = true
local Highlights = true

createToggle("كشف لوت وشنط الخصوم (Item ESP)", true, function(s) ItemESP = s end)
createToggle("تحديد أماكن اللاعبين (Neon Highlight)", true, function(s) Highlights = s end)

-- Safe Loop (No Memory Hooking)
RunService.RenderStepped:Connect(function()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") then
            -- Highlight
            local hl = p.Character:FindFirstChild("HL901")
            if Highlights then
                if not hl then
                    hl = Instance.new("Highlight", p.Character)
                    hl.Name = "HL901"
                    hl.FillColor = Color3.fromRGB(138, 43, 226)
                end
            elseif hl then
                hl:Destroy()
            end

            -- Item ESP
            local head = p.Character.Head
            local bill = head:FindFirstChild("Bill901")
            if ItemESP then
                if not bill then
                    bill = Instance.new("BillboardGui", head)
                    bill.Name = "Bill901"
                    bill.Size = UDim2.new(0, 180, 0, 35)
                    bill.StudsOffset = Vector3.new(0, 2.5, 0)
                    bill.AlwaysOnTop = true

                    local txt = Instance.new("TextLabel", bill)
                    txt.Size = UDim2.new(1, 0, 1, 0)
                    txt.BackgroundTransparency = 1
                    txt.TextColor3 = Color3.fromRGB(255, 215, 0)
                    txt.Font = Enum.Font.GothamBold
                    txt.TextSize = 11
                    txt.TextStrokeTransparency = 0
                end

                local items = {}
                for _, t in ipairs(p.Character:GetChildren()) do if t:IsA("Tool") then table.insert(items, t.Name) end end
                if p:FindFirstChild("Backpack") then
                    for _, t in ipairs(p.Backpack:GetChildren()) do if t:IsA("Tool") then table.insert(items, t.Name) end end
                end

                local txt = bill:FindFirstChildOfClass("TextLabel")
                if txt then
                    txt.Text = "[" .. p.Name .. "]\n📦 " .. (#items > 0 and table.concat(items, ", ") or "بدون لوت")
                end
            elseif bill then
                bill:Destroy()
            end
        end
    end
end)
