-- ESP Logic
local function ClearStorage(player)
    if Storage[player] then
        if Storage[player].Billboard then
            Storage[player].Billboard:Destroy()
        end
        if Storage[player].Connections then
            for _, conn in ipairs(Storage[player].Connections) do
                conn:Disconnect()
            end
        end
        Storage[player] = nil
    end
end

local function UpdateItems(player)
    local data = Storage[player]
    if not data or not data.Container or not Config.Enabled then return end
    
    -- Clear old labels
    for _, child in ipairs(data.Container:GetChildren()) do
        if child:IsA("TextLabel") then
            child:Destroy()
        end
    end

    local Character = player.Character
    local Backpack = player:FindFirstChild("Backpack")
    local TotalItems = {}

    if Character then
        for _, tool in ipairs(Character:GetChildren()) do
            if tool:IsA("Tool") then
                table.insert(TotalItems, tool.Name)
            end
        end
    end

    if Backpack then
        for _, tool in ipairs(Backpack:GetChildren()) do
            if tool:IsA("Tool") then
                table.insert(TotalItems, tool.Name)
            end
        end
    end

    if #TotalItems == 0 then
        data.Billboard.Enabled = false
        return
    else
        data.Billboard.Enabled = true
    end

    for _, itemName in ipairs(TotalItems) do
        local textLabel = Instance.new("TextLabel")
        textLabel.Parent = data.Container
        textLabel.Size = UDim2.new(0, 0, 1, 0)
        textLabel.AutomaticSize = Enum.AutomaticSize.X
        textLabel.BackgroundTransparency = 1
        textLabel.Text = "[" .. itemName .. "]"
        textLabel.TextColor3 = Config.TextColor
        textLabel.Font = Config.Font
        textLabel.TextSize = Config.TextSize
        textLabel.TextStrokeTransparency = 0.3
        textLabel.TextStrokeColor3 = Config.StrokeColor
    end
end

local function MonitorInventory(player)
    if player == LocalPlayer then return end
    ClearStorage(player)

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "InvTextESP_" .. player.Name
    billboard.AlwaysOnTop = true
    billboard.Size = UDim2.new(0, 300, 0, 25)
    billboard.StudsOffset = Config.Offset
    billboard.Parent = MainGui -- Keep in UI for safety
    
    local container = Instance.new("Frame")
    container.Parent = billboard
    container.Size = UDim2.new(1, 0, 1, 0)
    container.BackgroundTransparency = 1
    
    local layout = Instance.new("UIListLayout")
    layout.Parent = container
    layout.FillDirection = Enum.FillDirection.Horizontal
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    layout.VerticalAlignment = Enum.VerticalAlignment.Center
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 4)

    Storage[player] = {
        Billboard = billboard,
        Container = container,
        Connections = {}
    }

    local function SetupCharacter(character)
        local root = character:WaitForChild("HumanoidRootPart", 10)
        if root then
            billboard.Adornee = root
        end
        UpdateItems(player)
        
        table.insert(Storage[player].Connections, character.ChildAdded:Connect(function() UpdateItems(player) end))
        table.insert(Storage[player].Connections, character.ChildRemoved:Connect(function() UpdateItems(player) end))
    end

    if player.Character then
        SetupCharacter(player.Character)
    end

    table.insert(Storage[player].Connections, player.CharacterAdded:Connect(SetupCharacter))

    local function SetupBackpack(backpack)
        table.insert(Storage[player].Connections, backpack.ChildAdded:Connect(function() UpdateItems(player) end))
        table.insert(Storage[player].Connections, backpack.ChildRemoved:Connect(function() UpdateItems(player) end))
        UpdateItems(player)
    end

    local backpack = player:FindFirstChild("Backpack")
    if backpack then SetupBackpack(backpack) end
    
    table.insert(Storage[player].Connections, player.ChildAdded:Connect(function(child)
        if child.Name == "Backpack" then SetupBackpack(child) end
    end))
end

-- Initialize
for _, player in ipairs(Players:GetPlayers()) do
    MonitorInventory(player)
end

Players.PlayerAdded:Connect(MonitorInventory)
Players.PlayerRemoving:Connect(ClearStorage)

-- Toggle Functionality
local function ToggleESP()
    Config.Enabled = not Config.Enabled
    
    local targetPos = Config.Enabled and UDim2.new(0, 45, 0.5, -10) or UDim2.new(0, 5, 0.5, -10)
    local targetColor = Config.Enabled and Color3.fromRGB(0, 255, 120) or Color3.fromRGB(255, 70, 70)
    
    TweenService:Create(ToggleInner, TweenInfo.new(0.3), {Position = targetPos, BackgroundColor3 = targetColor}):Play()
    StatusText.Text = "Status: " .. (Config.Enabled and "ON" or "OFF")
    StatusText.TextColor3 = targetColor
    
    for _, player in ipairs(Players:GetPlayers()) do
        if Storage[player] then
            Storage[player].Billboard.Enabled = Config.Enabled
            if Config.Enabled then
                UpdateItems(player)
            end
        end
    end
end

ToggleBtn.MouseButton1Click:Connect(ToggleESP)
