local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- ⚙️ [RADAR SETTINGS]
local RadarSettings = {
    Enabled = true,
    ShowHealth = true,
    ShowWeapon = true,
    ShowCoverStatus = true,
    RightsText = "KLO 901 RADAR"
}

-- 🎨 [WEAPON COLOR LOGIC]
local function getWeaponColor(character)
    local tool = character:FindFirstChildOfClass("Tool")
    if not tool then
        return Color3.fromRGB(240, 240, 240), "بدون سلاح" -- أبيض
    end

    local weaponName = tool.Name
    local lowerName = string.lower(weaponName)

    -- تحديد نوع السلاح لتلوين الاسم
    if string.find(lowerName, "ak") or string.find(lowerName, "m4") or string.find(lowerName, "shotgun") or string.find(lowerName, "rifle") or string.find(lowerName, "draco") then
        return Color3.fromRGB(255, 85, 0), weaponName -- أحمر/برتقالي للأسلحة القوية
    elseif string.find(lowerName, "pistol") or string.find(lowerName, "glock") or string.find(lowerName, "smg") or string.find(lowerName, "uzi") or string.find(lowerName, "taser") then
        return Color3.fromRGB(255, 215, 0), weaponName -- أصفر للمسدسات والرشاشات الخفيفة
    else
        return Color3.fromRGB(180, 255, 255), weaponName -- أزرق فاتح للبقية
    end
end

-- 🧱 [COVER CHECK - WALLCHECK LOGIC]
local function isPlayerInCover(targetCharacter)
    if not targetCharacter or not targetCharacter:FindFirstChild("Head") or not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("Head") then
        return true
    end

    local origin = Camera.CFrame.Position
    local targetPos = targetCharacter.Head.Position
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character, targetCharacter}

    local result = workspace:Raycast(origin, targetPos - origin, raycastParams)
    
    -- إذا طلع العائق معناه اللاعب بـ كفر (أحمر)، إذا مافيه عائق يعني بـ أوبن (أخضر)
    return result ~= nil 
end

-- 🖼️ [DRAWING ESP STORAGE]
local ESP_Cache = {}

local function createESP(player)
    local drawings = {
        Text = Drawing.new("Text"),
        Box = Drawing.new("Square")
    }

    drawings.Text.Size = 13
    drawings.Text.Center = true
    drawings.Text.Outline = true
    drawings.Text.OutlineColor = Color3.fromRGB(0, 0, 0)
    drawings.Text.Visible = false

    drawings.Box.Thickness = 1.5
    drawings.Box.Filled = false
    drawings.Box.Visible = false

    ESP_Cache[player] = drawings
end

local function removeESP(player)
    if ESP_Cache[player] then
        ESP_Cache[player].Text:Remove()
        ESP_Cache[player].Box:Remove()
        ESP_Cache[player] = nil
    end
end

-- Clean up on Player Leave
Players.PlayerRemoving:Connect(removeESP)

-- 🚀 [RADAR RENDER LOOP]
RunService.RenderStepped:Connect(function()
    if not RadarSettings.Enabled then
        for _, drawings in pairs(ESP_Cache) do
            drawings.Text.Visible = false
            drawings.Box.Visible = false
        end
        return
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if not ESP_Cache[player] then
                createESP(player)
            end

            local drawings = ESP_Cache[player]
            local character = player.Character

            if character and character:FindFirstChild("HumanoidRootPart") and character:FindFirstChildOfClass("Humanoid") then
                local humanoid = character:FindFirstChildOfClass("Humanoid")

                if humanoid.Health > 0 then
                    local hrpPos, onScreen = Camera:WorldToViewportPoint(character.HumanoidRootPart.Position)

                    if onScreen then
                        -- 1. فحص لون السلاح واسمه
                        local nameColor, weaponName = getWeaponColor(character)

                        -- 2. فحص حالة الكفر (أوبن / كفر)
                        local inCover = isPlayerInCover(character)
                        local statusColor = inCover and Color3.fromRGB(255, 30, 30) or Color3.fromRGB(30, 255, 100) -- أحمر لكفر / أخضر لأوبن

                        -- 3. تجهيز نص الرادار
                        local healthText = math.floor(humanoid.Health) .. " HP"
                        local statusText = inCover and "[Cover 🟥]" or "[Open 🟩]"
                        
                        drawings.Text.Text = string.format("%s | %s\n🔫 %s | %s", player.DisplayName, healthText, weaponName, statusText)
                        drawings.Text.Position = Vector2.new(hrpPos.X, hrpPos.Y - 45)
                        drawings.Text.Color = nameColor
                        drawings.Text.Visible = true

                        -- 4. رسم المربع حول اللاعب بلون الكفر/الأوبن
                        drawings.Box.Size = Vector2.new(2000 / hrpPos.Z, 3000 / hrpPos.Z)
                        drawings.Box.Position = Vector2.new(hrpPos.X - drawings.Box.Size.X / 2, hrpPos.Y - drawings.Box.Size.Y / 2)
                        drawings.Box.Color = statusColor
                        drawings.Box.Visible = true
                    else
                        drawings.Text.Visible = false
                        drawings.Box.Visible = false
                    end
                else
                    drawings.Text.Visible = false
                    drawings.Box.Visible = false
                end
            else
                drawings.Text.Visible = false
                drawings.Box.Visible = false
            end
        end
    end
end)
