local function createFeatureToggle(parent, titleText, default, callback)
    local ToggleFrame = Instance.new("Frame")
    ToggleFrame.Size = UDim2.new(1, 0, 0, 34)
    ToggleFrame.BackgroundColor3 = Color3.fromRGB(32, 32, 42)
    ToggleFrame.Parent = parent
    Instance.new("UICorner", ToggleFrame).CornerRadius = UDim.new(0, 6)

    local Txt = Instance.new("TextLabel")
    Txt.Size = UDim2.new(0.7, 0, 1, 0)
    Txt.Position = UDim2.new(0, 10, 0, 0)
    Txt.Text = titleText
    Txt.TextColor3 = Color3.fromRGB(220, 220, 230)
    Txt.Font = Enum.Font.Gotham
    Txt.TextSize = 10
    Txt.TextXAlignment = Enum.TextXAlignment.Left
    Txt.BackgroundTransparency = 1
    Txt.Parent = ToggleFrame

    local Switch = Instance.new("TextButton")
    Switch.Size = UDim2.new(0, 36, 0, 18)
    Switch.Position = UDim2.new(1, -42, 0.5, -9)
    Switch.BackgroundColor3 = default and Color3.fromRGB(0, 180, 230) or Color3.fromRGB(50, 50, 65)
    Switch.Text = ""
    Switch.Parent = ToggleFrame
    Instance.new("UICorner", Switch).CornerRadius = UDim.new(1, 0)

    local state = default
    Switch.MouseButton1Click:Connect(function()
        state = not state
        Switch.BackgroundColor3 = state and Color3.fromRGB(0, 180, 230) or Color3.fromRGB(50, 50, 65)
        callback(state)
    end)
end

